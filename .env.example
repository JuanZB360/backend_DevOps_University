# Plantilla de backend/.env — cópiala y rellena los valores:
#   cp .env.example .env
# Formato: CLAVE=valor, sin comillas (vale como .properties y como shell).

# ── Base de datos PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devopsu
DB_USERNAME=devopsu
DB_PASSWORD=cambia-esta-contraseña
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Servidor ──────────────────────────────────────────────────────────────
SERVER_PORT=8090

# ── Sesiones y seguridad ──────────────────────────────────────────────────
# Duración de una sesión iniciada (ej.: 12h, 7d, 30d).
APP_SESSION_TTL=30d
# Orígenes que pueden llamar a la API (separados por comas). En producción,
# incluye tu dominio de Vercel (https://*.vercel.app cubre producción y previews):
APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*],https://*.vercel.app
